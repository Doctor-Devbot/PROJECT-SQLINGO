# =============================================================================
# Modelo de variáveis de ambiente do SQLINGO (Aula 15 - Gerenciamento de Segredos)
#
# 1. Copie este arquivo para .env no desenvolvimento local e ajuste o que usar.
# 2. NUNCA suba o .env para o GitHub: ele já está listado no .gitignore.
# 3. Na nuvem (Render), cadastre essas mesmas chaves no painel
#    (Environment), NÃO em arquivo: o painel injeta os valores em os.environ.
# =============================================================================

# Chave de assinatura dos tokens JWT (troque por um valor secreto longo)
JWT_SECRET_KEY=troque-por-uma-chave-secreta-bem-longa

# -----------------------------------------------------------------------------
# Banco de dados na nuvem (MySQL do Aiven) - preencha APENAS no painel do
# Render (Environment Variables). Localmente, deixe tudo comentado: sem
# DB_PASSWORD a API usa o SQLite automaticamente.
# -----------------------------------------------------------------------------
# DB_PASSWORD=senha_do_banco_no_aiven
# DB_USER=avnadmin
# DB_HOST=mysql-xxxxxx.aivencloud.com
# DB_PORT=28010
# DB_NAME=defaultdb

# Ambiente de execução da API
FLASK_ENV=production
